# delete blacklisted item
data remove block ~ ~ ~ Items[{components: {"minecraft:custom_data": {id:"FISHING_ROD"}}}]
data remove block ~ ~ ~ Items[{components: {"minecraft:custom_data": {id:"LOBBY_BUTTON"}}}]
data remove block ~ ~ ~ Items[{components: {"minecraft:custom_data": {menu_item:true}}}]
data remove block ~ ~ ~ Items[{components: {"minecraft:custom_data": {menu_preview:true}}}]
data remove block ~ ~ ~ Items[{components: {"minecraft:custom_data": {artifact:true}}}]
data remove block ~ ~ ~ Items[{components: {"minecraft:custom_data": {game_item:true}}}]
